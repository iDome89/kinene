---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { business } from '@/config/business';
import { telLink, whatsappLink } from '@/lib/links';

/*
  Placeholder until the breeding section is ready. Kept as a route so existing
  links and shares do not 404, but noindex and unlinked from the navigation.
*/
export const prerender = false;

const description = 'La sezione dedicata all’allevamento di Cane Corso Kinene sarà disponibile presto.';
---

<Base title="Allevamento — presto disponibile" description={description} noindex>
  <Section>
    <div class="mx-auto max-w-xl text-center">
      <Logo size={110} class="mx-auto" priority />

      <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-edge bg-surface-tint px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
        <Icon name="clock" size={14} class="text-primary" />
        Presto disponibile
      </p>

      <h1 class="mt-5 text-[clamp(1.9rem,1.4rem+2.2vw,2.8rem)] font-semibold">
        La sezione allevamento sta arrivando
      </h1>

      <p class="mt-5 leading-relaxed text-muted">
        Stiamo preparando le pagine dedicate ai nostri Cane Corso: riproduttori, cucciolate e criteri di
        selezione. Nel frattempo, per qualsiasi informazione sull’allevamento scrivici o chiamaci
        direttamente.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button
          href={whatsappLink('Ciao Kinene, vorrei informazioni sull’allevamento di Cane Corso.')}
          variant="accent"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={18} />
          Chiedi dell’allevamento
        </Button>
        <Button href={telLink()} variant="outline" size="lg">
          <Icon name="phone" size={18} />
          {business.contact.phoneDisplay}
        </Button>
      </div>

      <p class="mt-10 text-sm text-muted">
        Cerchi invece <a href="/servizi/pensione" class="text-accent underline underline-offset-2">pensione,
        asilo o dog sitting</a>? Quei servizi sono già attivi.
      </p>
    </div>
  </Section>
</Base>
