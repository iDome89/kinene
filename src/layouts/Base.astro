---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { business, openingHours } from '@/config/business';
import { fullAddress } from '@/lib/links';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumb?: readonly { name: string; href: string }[];
}

const { title, description, noindex = false, breadcrumb } = Astro.props;

const pageTitle = title === business.tradeName ? title : `${title} · ${business.tradeName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kinene.it').href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AnimalShelter',
  additionalType: 'https://schema.org/PetStore',
  '@id': `${Astro.site ?? 'https://kinene.it'}#business`,
  name: business.tradeName,
  legalName: business.legalName,
  description,
  url: Astro.site?.href ?? 'https://kinene.it',
  telephone: business.contact.phone,
  ...(business.contact.email ? { email: business.contact.email } : {}),
  ...(business.vatNumber ? { vatID: business.vatNumber } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.province,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.address.latitude,
    longitude: business.address.longitude,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Provincia di Modena' },
    { '@type': 'AdministrativeArea', name: 'Emilia-Romagna' },
  ],
  openingHoursSpecification: [
    ...openingHours.weekdays.slots.map((slot) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: openingHours.weekdays.schemaDays,
      opens: slot.from,
      closes: slot.to,
    })),
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: openingHours.weekend.schemaDays,
      opens: '00:00',
      closes: '00:00',
      description: 'Solo su appuntamento',
    },
  ],
  sameAs: [business.contact.instagramUrl],
};

const breadcrumbSchema = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, Astro.site ?? 'https://kinene.it').href,
  })),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.tradeName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#42502f" />
    <meta name="geo.region" content="IT-MO" />
    <meta name="geo.placename" content={business.address.locality} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />}
    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <span class="sr-only" data-address={fullAddress}></span>
  </body>
</html>
