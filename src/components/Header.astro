---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { isActivePath, primaryNav, telLink } from '@/lib/links';
import { business } from '@/config/business';

const path = Astro.url.pathname;
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-on-accent"
>
  Vai al contenuto principale
</a>

<header class="sticky top-0 z-40 border-b border-edge bg-surface/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={`${business.tradeName} — home`}>
      <Logo size={52} priority />
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.45rem] font-semibold text-heading">Kinene</span>
        <span class="mt-1 text-[0.55rem] font-medium uppercase tracking-[0.28em] text-muted">
          Guiglia · Modena
        </span>
      </span>
    </a>

    <nav aria-label="Navigazione principale" class="hidden items-center gap-1 lg:flex">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={isActivePath(path, item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-[0.95rem] no-underline transition-colors duration-200',
              isActivePath(path, item.href)
                ? 'bg-surface-tint font-medium text-body'
                : 'text-muted hover:bg-surface-tint hover:text-body',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={telLink()}
        class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 text-[0.95rem] text-muted no-underline transition-colors hover:bg-surface-tint hover:text-body"
      >
        <Icon name="phone" size={17} />
        {business.contact.phoneDisplay}
      </a>
      <Button href="/prenota" variant="accent">Prenota</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex min-h-11 min-w-11 list-none items-center justify-center rounded-full text-body transition-colors hover:bg-surface-tint [&::-webkit-details-marker]:hidden"
        aria-label="Apri il menu"
      >
        <Icon name="menu" size={24} class="group-open:hidden" />
        <Icon name="close" size={24} class="hidden group-open:block" />
      </summary>

      <nav
        aria-label="Navigazione principale"
        class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(19rem,calc(100vw-2.5rem))] rounded-[var(--radius-card)] border border-edge bg-surface-raised p-3 shadow-2xl shadow-black/10"
      >
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          {
            primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActivePath(path, item.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center rounded-lg px-4 no-underline transition-colors',
                    isActivePath(path, item.href)
                      ? 'bg-surface-tint font-medium text-body'
                      : 'text-muted hover:bg-surface-tint hover:text-body',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-3 flex flex-col gap-2 border-t border-edge pt-3">
          <Button href="/prenota" variant="accent" class="w-full">Prenota</Button>
          <Button href={telLink()} variant="outline" class="w-full">
            <Icon name="phone" size={17} />
            {business.contact.phoneDisplay}
          </Button>
        </div>
      </nav>
    </details>
  </div>
</header>
