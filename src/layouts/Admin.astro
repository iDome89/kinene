---
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import { storageHealth } from '@/lib/storage-health';

interface Props {
  title: string;
  active?: 'richieste' | 'calendario' | 'chiusure' | 'galleria' | 'recensioni';
}

const { title, active } = Astro.props;

const nav = [
  { key: 'richieste', href: '/admin', label: 'Richieste' },
  { key: 'calendario', href: '/admin/calendario', label: 'Calendario' },
  { key: 'chiusure', href: '/admin/chiusure', label: 'Chiusure e capienza' },
  { key: 'galleria', href: '/admin/galleria', label: 'Galleria' },
  { key: 'recensioni', href: '/admin/recensioni', label: 'Recensioni' },
] as const;

const storage = storageHealth(
  process.env.DATABASE_URL ?? 'file:./data/kinene.db',
  process.env.UPLOAD_DIR ?? './data/uploads',
);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Kinene admin</title>
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface-sunken">
    <header class="border-b border-edge bg-surface-raised">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 py-3">
        <div class="flex items-center gap-3">
          <Logo size={40} priority />
          <span class="font-display text-lg font-semibold">Gestione</span>
        </div>

        <nav aria-label="Sezioni" class="flex flex-wrap gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
                class:list={[
                  'rounded-full px-4 py-2 text-sm no-underline transition-colors',
                  active === item.key
                    ? 'bg-primary font-medium text-on-primary'
                    : 'text-muted hover:bg-surface-tint hover:text-body',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3">
          <a href="/" class="text-sm text-muted no-underline hover:underline">Vedi il sito</a>
          <form method="POST" action="/admin/logout">
            <button
              type="submit"
              class="min-h-11 rounded-full border border-edge-strong px-4 text-sm transition-colors hover:bg-surface-tint"
            >
              Esci
            </button>
          </form>
        </div>
      </div>
    </header>

    {
      !storage.durable && (
        <div class="border-b border-danger/35 bg-danger-surface">
          <div class="wrap flex gap-4 py-4" role="alert">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-danger"
              aria-hidden="true"
            >
              <path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
            <div class="min-w-0">
              <p class="m-0 font-semibold text-danger">{storage.headline}</p>
              <p class="m-0 mt-1 text-sm leading-relaxed">{storage.detail}</p>
            </div>
          </div>
        </div>
      )
    }

    <main class="wrap flex-1 py-10">
      <slot />
    </main>

    <footer class="border-t border-edge bg-surface-raised py-5">
      <div class="wrap flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
        <p class="m-0">
          {storage.durable ? storage.detail : 'Scarica subito una copia: sul server non è al sicuro.'}
        </p>
        <a
          href="/admin/backup.json"
          download
          class="min-h-11 rounded-full border border-edge-strong px-4 py-2 no-underline transition-colors hover:bg-surface-tint"
        >
          Scarica backup
        </a>
      </div>
    </footer>
  </body>
</html>
