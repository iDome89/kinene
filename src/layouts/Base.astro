---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { business, openingHours, serviceList } from '@/config/business';
import { fullAddress } from '@/lib/links';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /* Use verbatim instead of appending the brand — for the home page, which needs its own keywords. */
  fullTitle?: string;
  breadcrumb?: readonly { name: string; href: string }[];
}

const { title, description, noindex = false, fullTitle, breadcrumb } = Astro.props;

const pageTitle = fullTitle ?? `${title} · ${business.tradeName}`;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://kinene.it').href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kinene.it').href;

const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? 'https://kinene.it';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteOrigin}/#business`,
  name: business.tradeName,
  legalName: business.legalName,
  description:
    'Pensione, asilo diurno e asilo notturno per cani a Guiglia (MO), gestiti da un’addestratrice cinofila. ' +
    'Su richiesta accogliamo anche gatti, roditori, uccelli e rettili. Allevamento di Cane Corso.',
  image: ogImage,
  logo: new URL('/icon-512.png', siteOrigin).href,
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Contanti',
  knowsLanguage: 'it',
  url: Astro.site?.href ?? 'https://kinene.it',
  telephone: business.contact.phone,
  ...(business.contact.email ? { email: business.contact.email } : {}),
  ...(business.vatNumber ? { vatID: business.vatNumber } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.province,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.address.latitude,
    longitude: business.address.longitude,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Provincia di Modena' },
    { '@type': 'AdministrativeArea', name: 'Emilia-Romagna' },
  ],
  /* Weekend is by appointment only, so those days are omitted: an absent day means closed. */
  openingHoursSpecification: openingHours.weekdays.slots.map((slot) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: openingHours.weekdays.schemaDays,
    opens: slot.from,
    closes: slot.to,
  })),
  sameAs: [business.contact.instagramUrl],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servizi per cani',
    itemListElement: serviceList.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.name, serviceType: service.name },
      price: (service.priceCents / 100).toFixed(2),
      priceCurrency: 'EUR',
      eligibleDuration: {
        '@type': 'QuantitativeValue',
        maxValue: service.maxUnits,
        unitCode: service.priceUnit === 'notte' ? 'DAY' : 'DAY',
      },
    })),
  },
};

const breadcrumbSchema = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, Astro.site ?? 'https://kinene.it').href,
  })),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.tradeName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kinene — pensione e asilo per cani a Guiglia, Appennino modenese" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#42502f" />
    <meta name="geo.region" content="IT-MO" />
    <meta name="geo.placename" content={business.address.locality} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />}
    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <span class="sr-only" data-address={fullAddress}></span>
  </body>
</html>
