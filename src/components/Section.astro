---
interface Props {
  id?: string;
  tone?: 'plain' | 'sunken' | 'tint' | 'inverse';
  class?: string;
  labelledby?: string;
}

const { id, tone = 'plain', class: className = '', labelledby } = Astro.props;

const tones = {
  plain: '',
  sunken: 'bg-surface-sunken',
  tint: 'bg-surface-tint',
  inverse: 'bg-surface-inverse text-inverse',
};
---

<section id={id} aria-labelledby={labelledby} class={`py-16 md:py-[var(--spacing-section)] ${tones[tone]} ${className}`}>
  <div class="wrap">
    <slot />
  </div>
</section>
